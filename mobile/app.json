{
  "expo": {
    "name": "NexAccess Mobile",
    "slug": "nexaccess-mobile",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexaccess-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nexaccess.mobile.demo"
    },
    "android": {
      "versionCode": 4,
      "package": "com.nexaccess.mobile.demo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#DBEDE5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-secure-store",
      "expo-system-ui",
      "./plugins/withNexAccessHce"
    ]
  }
}
